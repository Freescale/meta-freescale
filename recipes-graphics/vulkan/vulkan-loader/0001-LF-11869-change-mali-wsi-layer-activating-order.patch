From dc513031b3f39538cfe1d235f95e47b6778cbc20 Mon Sep 17 00:00:00 2001
From: Yuan Tian <yuan.tian@nxp.com>
Date: Sat, 27 Apr 2024 06:06:54 +0800
Subject: [PATCH] LF-11869 change mali wsi layer activating order

Upstream-Status: Inappropriate [embedded specific]

Signed-off-by: Yuan Tian <yuan.tian@nxp.com>
---
 loader/loader.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/loader/loader.c b/loader/loader.c
index 7a547fd37200..10de24964dd9 100644
--- a/loader/loader.c
+++ b/loader/loader.c
@@ -3465,6 +3465,7 @@ VkResult add_data_files(const struct loader_instance *inst, struct loader_string
                 if (NULL == dir_stream) {
                     continue;
                 }
+                bool has_wsi_layer = false;
                 while (1) {
                     errno = 0;
                     // NOLINTNEXTLINE(concurrency-mt-unsafe) - readdir is safe here since each thread uses its own dir_stream
@@ -3488,6 +3489,10 @@ VkResult add_data_files(const struct loader_instance *inst, struct loader_string
                     name = full_path;
 
                     VkResult local_res;
+                    if (!strcmp(name, "/etc/vulkan/implicit_layer.d/VkLayer_window_system_integration.json")) {
+                        has_wsi_layer = true;
+                        continue;
+                    }
                     local_res = add_if_manifest_file(inst, name, out_files);
 
                     // Incomplete means this was not a valid data file.
@@ -3499,6 +3504,10 @@ VkResult add_data_files(const struct loader_instance *inst, struct loader_string
                         break;
                     }
                 }
+                if (has_wsi_layer) {
+                    name = "/etc/vulkan/implicit_layer.d/VkLayer_window_system_integration.json";
+                    vk_result = add_if_manifest_file(inst, name, out_files);
+                }
                 loader_closedir(inst, dir_stream);
                 if (vk_result != VK_SUCCESS) {
                     goto out;
